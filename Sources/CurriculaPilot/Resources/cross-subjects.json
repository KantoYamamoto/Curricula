      "text": "第２　各学年の目標及び内容　　"
    },
    {
      "code": "82802D0000000000",
      "frameworkID": "fw.cross-music",
      "locator": "CSV record 2726; No 2724",
      "parentCode": "8280200000000000",
      "sourceID": "src.mext-82v12",
