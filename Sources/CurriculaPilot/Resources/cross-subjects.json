      "text": "Ｃ　読むこと"
    },
    {
      "code": "82102C3231000000",
      "frameworkID": "fw.cross-japanese",
      "locator": "CSV record 213; No 211",
      "parentCode": "82102C3230000000",
      "sourceID": "src.mext-82v12",
      "subject": "国語",
      "text": "(1) 読むことに関する次の事項を身に付けることができるよう指導する。"
    },
    {
      "code": "82102C3231200000",
      "frameworkID": "fw.cross-japanese",
      "locator": "CSV record 215; No 213",
      "parentCode": "82102C3231000000",
      "sourceID": "src.mext-82v12",
      "subject": "国語",
